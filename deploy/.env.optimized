# =============================================================================
# Sub2API 延迟优化配置文件（安全版）
# =============================================================================
# 使用方法：
# 1. 备份现有配置（如果有）: cp .env .env.backup
# 2. 复制此文件：cp .env.optimized .env
# 3. 修改必要配置（数据库密码、JWT 密钥等）
# 4. 重启容器：docker-compose down && docker-compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 必需配置（请修改为你的实际值）
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=change_this_secure_password
ADMIN_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 延迟优化配置（核心改动）
# -----------------------------------------------------------------------------

# 1. 网关连接池优化（已验证安全值）
# 增加连接池容量，减少连接等待时间
GATEWAY_MAX_IDLE_CONNS=8192
GATEWAY_MAX_IDLE_CONNS_PER_HOST=4096
GATEWAY_MAX_CONNS_PER_HOST=2048

# 2. 调度超时优化（减少排队等待）
# 原值：120s → 优化：45s（减少慢请求堆积）
GATEWAY_SCHEDULING_STICKY_SESSION_WAIT_TIMEOUT=45s

# 原值：30s → 优化：20s（快速失败，避免用户长时间等待）
GATEWAY_SCHEDULING_FALLBACK_WAIT_TIMEOUT=20s

# 3. 流式响应超时（防止客户端断开）
# 新增：流数据间隔超时（秒），0=禁用
GATEWAY_STREAM_DATA_INTERVAL_TIMEOUT=180

# 4. HTTP/2 优化（提升并发性能）
# 原值：50 → 优化：100（允许更多并发流）
SERVER_H2C_MAX_CONCURRENT_STREAMS=100

# 保持合理的空闲超时（原值 75s 已合理）
SERVER_H2C_IDLE_TIMEOUT=75

# 5. 数据库连接池（已优化，保持默认）
DATABASE_MAX_OPEN_CONNS=256
DATABASE_MAX_IDLE_CONNS=128
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# 6. Redis 连接池（已优化，保持默认）
REDIS_POOL_SIZE=4096
REDIS_MIN_IDLE_CONNS=256

# -----------------------------------------------------------------------------
# 其他配置（保持默认，不要修改）
# -----------------------------------------------------------------------------
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai
ADMIN_EMAIL=admin@sub2api.local
DATABASE_PORT=5432
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_MAX_CONNECTIONS=1024
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXCLIENTS=50000
REDIS_ENABLE_TLS=false
LOG_LEVEL=info
LOG_FORMAT=json
